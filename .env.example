# Nothing loads this file automatically. Either export these variables in your
# shell / deploy platform, or copy to .env and run `npm run start:env`
# (uses Node's built-in --env-file, Node >= 20.6).
GEMINI_API_KEY=your_key_from_aistudio.google.com/apikey
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PORT=8080

# Required for the HTTP server (server.js): clients must send
# "Authorization: Bearer <MCP_AUTH_TOKEN>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Only if you deliberately want an open endpoint with no token (not recommended).
# ALLOW_UNAUTHENTICATED=true
